load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# Export headers for distribution bundling.
filegroup(
    name = "simpletiff_headers",
    srcs = glob(["include/**/*.h"]),
    visibility = ["//visibility:public"],
)

# Build config to choose JPEG decoder
config_setting(
    name = "use_jpgd",
    define_values = {"jpeg_decoder": "jpgd"},
)

# Core SimpleTIFF library
cc_library(
    name = "simpletiff_lib",
    srcs = [
        "src/ccitt.cpp",
        "src/ccitt_tables.cpp",
        "src/deflate.cpp",
        "src/image_writer.cpp",
        "src/index.cpp",
        "src/io_utils_common.cpp",
        "src/jpeg2000.cpp",
        "src/lzw.cpp",
        "src/ndpi_mcu_tiling.cpp",
        "src/predictor.cpp",
        "src/reader.cpp",
        "src/tiff_parser.cpp",
        "src/zstd.cpp",
    ] + select({
        ":use_jpgd": ["src/io_utils_jpgd.cpp"],
        "//conditions:default": ["src/io_utils_libjpeg.cpp"],
    }),
    hdrs = [
        "include/simpletiff/ccitt.h",
        "include/simpletiff/decompression.h",
        "include/simpletiff/deflate.h",
        "include/simpletiff/image_writer.h",
        "include/simpletiff/index.h",
        "include/simpletiff/internal/ccitt_tables.h",
        "include/simpletiff/internal/ndpi_mcu_tiling.h",
        "include/simpletiff/io_utils.h",
        "include/simpletiff/jpeg2000.h",
        "include/simpletiff/lzw.h",
        "include/simpletiff/predictor.h",
        "include/simpletiff/reader.h",
        "include/simpletiff/tiff_constants.h",
        "include/simpletiff/tiff_parser.h",
        "include/simpletiff/zstd.h",
    ],
    copts = [
        "-std=c++20",
        "-DNDEBUG",
        "-Wno-unused-parameter",
    ] + select({
        "@platforms//cpu:wasm32": [
            "-fexceptions",  # Enable exceptions for WASM
        ],
        "//conditions:default": [],
    }),
    defines = ["SIMPLETIFF_HAS_PNG"] + select({
        "@platforms//cpu:wasm32": [],
        "//conditions:default": ["SIMPLETIFF_HAS_OPENJPEG"],
    }),
    includes = ["include"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "@aifocore-cpp//:portability",
        "@aifocore-cpp//:result",
        "@libpng",
        "@zlib",
        "@zstd",
    ] + select({
        "@platforms//cpu:wasm32": [],
        "//conditions:default": ["@openjp2"],
    }) + select({
        ":use_jpgd": ["@jpeg-compressor//:jpgd"],
        "//conditions:default": ["@libjpeg_turbo//:jpeg"],
    }),
)

# Create a DLL for Windows (or shared lib on Linux/macOS)
# We use a different name for the binary target and copy the output to simpletiff.dll
# to avoid Bazel's "dynamic_" prefix behavior on Windows.
cc_binary(
    name = "simpletiff_bin",
    linkshared = True,
    visibility = ["//visibility:private"],
    deps = [":simpletiff_lib"],
)

# Platform-specific genrules to rename the output
genrule(
    name = "simpletiff_windows",
    srcs = [":simpletiff_bin"],
    outs = ["simpletiff.dll"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "simpletiff_macos",
    srcs = [":simpletiff_bin"],
    outs = ["libsimpletiff.dylib"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "simpletiff_linux",
    srcs = [":simpletiff_bin"],
    outs = ["libsimpletiff.so"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

alias(
    name = "simpletiff",
    actual = select({
        "@platforms//os:windows": ":simpletiff_windows",
        "@platforms//os:macos": ":simpletiff_macos",
        "//conditions:default": ":simpletiff_linux",
    }),
    visibility = ["//visibility:public"],
)

