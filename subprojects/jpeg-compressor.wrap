# jpgd JPEG decoder (Highway-accelerated) from NKI-AI/jpeg-compressor. Used only
# when configured with -Djpeg_decoder=jpgd. Its root meson.build exposes the
# `jpgd_dep` variable. The revision matches the git_override in MODULE.bazel.
[wrap-git]
url = https://github.com/NKI-AI/jpeg-compressor.git
revision = 927f759d349b7ce2588d50465d719c42011ccb4b

[provide]
jpgd = jpgd_dep
