# aifocore is published standalone (synced from the monorepo via Copybara) at
# NKI-AI/aifocore. Its root meson.build provides the `aifocore` dependency
# (see `meson.override_dependency('aifocore', ...)`). The revision is pinned to
# match the `git_override` in MODULE.bazel so the Bazel and Meson builds use the
# same aifocore commit.
[wrap-git]
url = https://github.com/NKI-AI/aifocore.git
revision = fc0ba506f0a6838da930849cb4252e770a1fa6b8

[provide]
dependency_names = aifocore
